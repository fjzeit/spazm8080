; 051C: EX_DONE - Return DE as result
EB              ; XCHG
C9              ; RET

; 0524: EX_NH - 'H' found, skip it and return
23              ; INX H
22 0A 04        ; SHLD LNPTR
EB              ; XCHG
C9              ; RET

; 0528: EX_SYM - Parse symbol
CD 28 04; CALL LOOKUP
C9              ; RET

; 052C: EX_HEX - $XX hex format
23              ; INX H ; skip $
22 0A 04        ; SHLD LNPTR
21 00 00        ; LXI H,0
EB              ; XCHG ; DE = 0, will accumulate
2A 0A 04        ; LHLD LNPTR

