; STAGE1.HEX v1 - Minimal assembler with labels
; Built by SPAZM0
;
; Features:
;   - Labels (LABEL:)
;   - ORG, END directives
;   - Hex bytes with symbol references
;   - Two-pass assembly
;
; Memory Layout:
;   0100-061F: Code (~1296 bytes)
;   0620-069F: Token buffer (128 bytes)
;   06A0-06EF: Line buffer (80 bytes) - note: shares with vars
;   06F0-06FB: Variables (12 bytes)
;   0700-077F: Input buffer (128 bytes)
;   0780-07FF: Output buffer (128 bytes)
;   0800-083F: Output FCB (64 bytes)
;   0840-0C3F: Symbol table (1024 bytes, 128 entries)
;
; Variables at 0580:
;   06F0: PASS    (1 byte)  - 0=pass1, 1=pass2
;   06F1: ICNT    (1 byte)  - Input buffer count
;   06F2: IPTR    (2 bytes) - Input buffer pointer
;   06F4: OCNT    (1 byte)  - Output buffer count
;   06F5: OPTR    (2 bytes) - Output buffer pointer
;   06F7: SYMCNT  (1 byte)  - Symbol count
;   06F8: LOCTR   (2 bytes) - Location counter
;   06FA: LNPTR   (2 bytes) - Line pointer (current parse position)
;
; Constants:
;   BDOS=0005 BOOT=0000 FCB=005C
;   TOKBUF=0600 LINBUF=0680 IBUF=0700 OBUF=0780
;   IFCB=005C OFCB=0800 SYMTAB=0840

; ============================================================
; 0100: START - Entry point
; ============================================================
; Set FCB extension to .8HX
21 65 00; LXI H,0065H (FCB+9)
36 38; MVI M,'8'
23; INX H
36 48; MVI M,'H'
23; INX H
36 58; MVI M,'X'

; Open input file
11 5C 00; LXI D,005CH (FCB)
0E 0F; MVI C,15 (open)
CD 05 00; CALL BDOS
3C; INR A
CA 40 04; JZ NOFILE (shifted +3)

; Copy FCB to OFCB, set .COM extension
21 5C 00; LXI H,005CH
11 00 08; LXI D,0800H (OFCB)
06 09; MVI B,9

; 011F: CPFCB
7E; MOV A,M
12; STAX D
23; INX H
13; INX D
05; DCR B
C2 1F 01; JNZ CPFCB

; Set .COM extension
3E 43; MVI A,'C'
12; STAX D
13; INX D
3E 4F; MVI A,'O'
12; STAX D
13; INX D
3E 4D; MVI A,'M'
12; STAX D
13; INX D

; Zero rest of OFCB (24 bytes)
06 18; MVI B,24
; 0135: ZFCB
AF; XRA A
12; STAX D
13; INX D
05; DCR B
C2 35 01; JNZ ZFCB

; Delete old output, create new
11 00 08; LXI D,OFCB
0E 13; MVI C,19 (delete)
CD 05 00; CALL BDOS
11 00 08; LXI D,OFCB
0E 16; MVI C,22 (make)
CD 05 00; CALL BDOS
3C; INR A
CA 46 04; JZ DSKFUL (shifted +3)

; ============================================================
; 0150: INIT - Initialize variables
; ============================================================
AF; XRA A
32 F0 06; STA PASS (0840)
32 F1 06; STA ICNT
32 F4 06; STA OCNT
32 F7 06; STA SYMCNT

; Set LOCTR to 0100H
21 00 01; LXI H,0100H
22 F8 06; SHLD LOCTR

; Init OPTR
21 80 07; LXI H,0780H (OBUF)
22 F5 06; SHLD OPTR

; ============================================================
; 0169: PASS1 - First pass loop
; ============================================================
CD BC 01; CALL RDLINE (01BC)
DA 75 01; JC REWIND (EOF)
CD 04 02; CALL PARSE (0200)
C3 69 01; JMP PASS1

; 0175: Rewind for pass 2
11 5C 00; LXI D,FCB
0E 10; MVI C,16 (close)
CD 05 00; CALL BDOS
11 5C 00; LXI D,FCB
0E 0F; MVI C,15 (open)
CD 05 00; CALL BDOS

; 0185: P1END - Start pass 2
AF; XRA A
32 7C 00; STA FCB+32 (reset CR for pass 2)
32 68 00; STA FCB+12 (reset extent for pass 2)
; Re-open file to reload extent 0 info
11 5C 00; LXI D,FCB
0E 0F; MVI C,15 (open file)
CD 05 00; CALL BDOS
AF; XRA A (A=0 again after BDOS trashed it)
32 F1 06; STA ICNT
3C; INR A
32 F0 06; STA PASS

; Reset LOCTR
21 00 01; LXI H,0100H
22 F8 06; SHLD LOCTR

; ============================================================
; 01A2: PASS2 - Second pass loop
; ============================================================
CD BC 01; CALL RDLINE
DA AE 01; JC DONE
CD 04 02; CALL PARSE
C3 A2 01; JMP PASS2

; 01AE: DONE
CD 15 04; CALL FLUSH (shifted +3)
11 00 08; LXI D,OFCB
0E 10; MVI C,16 (close)
CD 05 00; CALL BDOS
C3 00 00; JMP BOOT

; ============================================================
; 01BC: RDLINE - Read line into LINBUF
; Returns: CY=1 if EOF
; ============================================================
21 80 06; LXI H,0680H (LINBUF)
06 7E; MVI B,126

; 01C1: RL1
CD 5C 03; CALL GETCHR (035C)
DA EC 01; JC RL_EOF
FE 0A; CPI 0AH (LF)
CA E2 01; JZ RL_EOL
FE 0D; CPI 0DH (CR)
CA C1 01; JZ RL1 (skip CR)
77; MOV M,A
23; INX H
05; DCR B
C2 C1 01; JNZ RL1

; 01D7: RL_TRUNC - Skip to EOL
CD 5C 03; CALL GETCHR
DA EC 01; JC RL_EOF
FE 0A; CPI 0AH
C2 D7 01; JNZ RL_TRUNC

; 01E2: RL_EOL
36 00; MVI M,0
21 80 06; LXI H,LINBUF
22 FA 06; SHLD LNPTR
B7; ORA A (clear CY)
C9; RET

; 01EC: RL_EOF
37; STC
C9; RET

; ============================================================
; 01EE: SKIPWS - Skip whitespace
; ============================================================
2A FA 06; LHLD LNPTR
; 01F1: SKW1
7E; MOV A,M
FE 20; CPI ' '
CA FC 01; JZ SKW2
FE 09; CPI TAB
C2 00 02; JNZ SKW3
; 01FC: SKW2
23; INX H
C3 F1 01; JMP SKW1
; 0200: SKW3
22 FA 06; SHLD LNPTR
C9; RET

; ============================================================
; 0204: PARSE - Parse current line
; ============================================================
CD EE 01; CALL SKIPWS
2A FA 06; LHLD LNPTR
7E; MOV A,M
B7; ORA A
C8; RZ (empty line)
FE 3B; CPI '
C8; RZ (comment)

; Check for label (scan for colon)
CD 1A 02; CALL CHKLBL (0220)
; Check for directive
CD 52 02; CALL CHKDIR (0250)
; Parse hex bytes
CD 99 02; CALL HEXLN (0290)
C9; RET

; ============================================================
; 021A: CHKLBL - Check for and define label
; ============================================================
2A FA 06; LHLD LNPTR
E5; PUSH H (save start)

; 021E: CL1 - Scan for colon
7E; MOV A,M
B7; ORA A
CA 3B 02; JZ CL_NO (end of line, no colon)
FE 3A; CPI ':'
CA 40 02; JZ CL_YES
FE 20; CPI ' '
CA 3B 02; JZ CL_NO
FE 09; CPI TAB
CA 3B 02; JZ CL_NO
FE 3B; CPI '
CA 3B 02; JZ CL_NO
23; INX H
C3 1E 02; JMP CL1

; 023B: CL_NO - Not a label
E1; POP H
22 FA 06; SHLD LNPTR
C9; RET

; 0240: CL_YES - Found label, define it
E1; POP H (start of label)
CD 6F 04; CALL DEFSYM (shifted +3)
; Skip past colon
2A FA 06; LHLD LNPTR

; 0247: CL2
7E; MOV A,M
23; INX H
FE 3A; CPI ':'
C2 47 02; JNZ CL2
22 FA 06; SHLD LNPTR
C9; RET

; ============================================================
; CHKDIR - Check for directive (ORG, END)
; O/o can only be ORG (no hex starts with O)
; E/e must check 2nd char: N/n = END, else hex (like E5)
; ============================================================
CD EE 01; CALL SKIPWS
2A FA 06; LHLD LNPTR
7E; MOV A,M
B7; ORA A
C8; RZ

; Check for 'O' (ORG) - no hex byte starts with O, so it's ORG
FE 4F; CPI 'O'
CA 80 02; JZ CD_ORG
FE 6F; CPI 'o'
CA 80 02; JZ CD_ORG
; Check for 'E' - could be END or hex like E5
FE 45; CPI 'E'
CA 70 02; JZ CK_END
FE 65; CPI 'e'
CA 70 02; JZ CK_END
C9; RET

; 0270: CK_END - Check if E is followed by N (END) or digit (hex)
23; INX H
7E; MOV A,M
FE 4E; CPI 'N'
CA 90 02; JZ CD_END
FE 6E; CPI 'n'
CA 90 02; JZ CD_END
; Not END, restore LNPTR
2A FA 06; LHLD LNPTR
C9; RET

; 0280: CD_ORG - Parse ORG
; Skip "ORG"
23; INX H
23; INX H
23; INX H
22 FA 06; SHLD LNPTR
CD EE 01; CALL SKIPWS
CD 4D 05; CALL EXPR (0300) - value in HL
22 F8 06; SHLD LOCTR
C9; RET

; 0290: CD_END - END directive
; Set line to null AND update LNPTR so HEXLN sees empty
21 80 06; LXI H,LINBUF (0680H)
36 00; MVI M,0
22 FA 06; SHLD LNPTR
C9; RET

; ============================================================
; 0299: HEXLN - Parse hex bytes with symbols
; Token-based approach:
;   2 hex chars = byte
;   4 hex chars = word (little endian)
;   otherwise = label reference
; ============================================================
CD EE 01; CALL SKIPWS
2A FA 06; LHLD LNPTR
7E; MOV A,M
B7; ORA A
C8; RZ (end of line)
FE 3B; CPI ';'
C8; RZ (comment)

; Check for < (low byte prefix)
FE 3C; CPI '<'
CA 32 03; JZ HXLO
; Check for > (high byte prefix)
FE 3E; CPI '>'
CA 40 03; JZ HXHI

; Scan token: count length, check if all hex
E5; PUSH H (save token start)
06 00; MVI B,0 (length counter)
0E 00; MVI C,0 (all-hex flag: 0=yes)

; 02B4: SCAN - scan loop
7E; MOV A,M
B7; ORA A
CA D7 02; JZ SCAND (end of string)
FE 20; CPI ' '
CA D7 02; JZ SCAND
FE 09; CPI TAB
CA D7 02; JZ SCAND
FE 3B; CPI ';'
CA D7 02; JZ SCAND

; Check if char is hex (preserve B,C)
C5; PUSH B
CD AA 03; CALL ISHEX_A (CY=1 if not hex)
C1; POP B
D2 D2 02; JNC SCANH (is hex)
0E 01; MVI C,1 (mark non-hex)
; 02D2: SCANH - char was hex, continue
04; INR B
23; INX H
C3 B4 02; JMP SCAN

; 02D7: SCAND - scan done
E1; POP H (restore token start)
; C=0 means all hex, B=length
79; MOV A,C
B7; ORA A
C2 4E 03; JNZ HXSYM (has non-hex = label)
; All hex - check length
78; MOV A,B
FE 02; CPI 2
CA EB 02; JZ PARB (2 chars = byte)
FE 04; CPI 4
CA 04 03; JZ PARW (4 chars = word)
; Not 2 or 4 = label
C3 4E 03; JMP HXSYM

; 02EB: PARB - Parse 2 hex chars as byte
7E; MOV A,M
CD C7 03; CALL HEXVAL
07; RLC
07; RLC
07; RLC
07; RLC
47; MOV B,A
23; INX H
7E; MOV A,M
CD C7 03; CALL HEXVAL
B0; ORA B
23; INX H
22 FA 06; SHLD LNPTR
CD D9 03; CALL OUTPUT
C3 99 02; JMP HEXLN

; 0304: PARW - Parse 4 hex chars as word (little endian)
; CAFE -> output FE then CA
; First 2 chars = high byte
7E; MOV A,M
CD C7 03; CALL HEXVAL
07; RLC
07; RLC
07; RLC
07; RLC
47; MOV B,A
23; INX H
7E; MOV A,M
CD C7 03; CALL HEXVAL
B0; ORA B
F5; PUSH PSW (save high byte)
23; INX H
; Next 2 chars = low byte
7E; MOV A,M
CD C7 03; CALL HEXVAL
07; RLC
07; RLC
07; RLC
07; RLC
47; MOV B,A
23; INX H
7E; MOV A,M
CD C7 03; CALL HEXVAL
B0; ORA B
23; INX H
22 FA 06; SHLD LNPTR
; Output low byte first
CD D9 03; CALL OUTPUT
F1; POP PSW
CD D9 03; CALL OUTPUT
C3 99 02; JMP HEXLN

; 0332: HXLO - Low byte prefix (<SYMBOL)
23; INX H
22 FA 06; SHLD LNPTR
CD B8 04; CALL LOOKUP
7D; MOV A,L
CD D9 03; CALL OUTPUT
C3 99 02; JMP HEXLN

; 0340: HXHI - High byte prefix (>SYMBOL)
23; INX H
22 FA 06; SHLD LNPTR
CD B8 04; CALL LOOKUP
7C; MOV A,H
CD D9 03; CALL OUTPUT
C3 99 02; JMP HEXLN

; 034E: HXSYM - Label reference, output low then high
CD B8 04; CALL LOOKUP
7D; MOV A,L
CD D9 03; CALL OUTPUT
7C; MOV A,H
CD D9 03; CALL OUTPUT
C3 99 02; JMP HEXLN

; ============================================================
; 035C: GETCHR - Buffered input
; Returns: A=char, CY=1 if EOF
; Preserves: B, H, L (BDOS destroys all registers)
; ============================================================
C5; PUSH B (preserve caller's B register)
E5; PUSH H (preserve caller's HL - used by RDLINE for LINBUF)
3A F1 06; LDA ICNT
B7; ORA A
C2 84 03; JNZ GC1 (shifted +1 for PUSH B)

; Buffer empty, read sector
11 00 07; LXI D,0840H (IBUF)
0E 1A; MVI C,26 (set DMA)
CD 05 00; CALL BDOS
11 5C 00; LXI D,FCB
0E 14; MVI C,20 (read seq)
CD 05 00; CALL BDOS
B7; ORA A
C2 A2 03; JNZ GC_EOF (shifted +2)
3E 80; MVI A,128
32 F1 06; STA ICNT
21 00 07; LXI H,IBUF
22 F2 06; SHLD IPTR

; 0384: GC1
2A F2 06; LHLD IPTR
7E; MOV A,M
23; INX H
22 F2 06; SHLD IPTR
F5; PUSH PSW
3A F1 06; LDA ICNT
3D; DCR A
32 F1 06; STA ICNT
F1; POP PSW
B7; ORA A
CA A2 03; JZ GC_EOF (null=EOF in LOLOS, shifted +2)
FE 1A; CPI 1AH
CA A2 03; JZ GC_EOF (shifted +2)
B7; ORA A (clear carry)
E1; POP H (restore caller's HL)
C1; POP B (restore caller's B)
C9; RET

; 03A2: GC_EOF (shifted +2)
E1; POP H (restore caller's HL)
C1; POP B (restore caller's B)
37; STC
C9; RET

; ============================================================
; 03A6: ISHEX - Check if char at [LNPTR] is hex
; Returns: CY=1 if not hex
; ============================================================
2A FA 06; LHLD LNPTR
7E; MOV A,M
; Fall through to ISHEX_A

; 03AA: ISHEX_A - Check if char in A is hex (for second char validation)
; Returns: CY=1 if not hex, A may be modified (uppercased)
; Convert to uppercase
FE 61; CPI 'a'
DA B6 03; JC IH1 (shifted +3)
FE 7B; CPI 'z'+1
D2 B6 03; JNC IH1 (shifted +3)
D6 20; SUI 20H
; 03B6: IH1
FE 30; CPI '0'
D8; RC (below '0')
FE 3A; CPI '9'+1
DA C5 03; JC IH2 (shifted +3)
FE 41; CPI 'A'
D8; RC
FE 47; CPI 'G'
3F; CMC
C9; RET
; 03C5: IH2
B7; ORA A (clear CY)
C9; RET

; ============================================================
; 03C7: HEXVAL - Convert hex char in A to value
; ============================================================
FE 61; CPI 'a'
DA CE 03; JC HV1 (shifted +3)
D6 20; SUI 20H (uppercase)
; 03CE: HV1
FE 41; CPI 'A'
DA D6 03; JC HV2 (shifted +3)
D6 37; SUI 37H
C9; RET
; 03D6: HV2
D6 30; SUI '0'
C9; RET

; ============================================================
; 03D9: OUTPUT - Buffered output (pass 2 only)
; ============================================================
F5; PUSH PSW
3A F0 06; LDA PASS
B7; ORA A
CA 0A 04; JZ OUT_P1 (shifted +3)
F1; POP PSW

; Pass 2 - output byte
E5; PUSH H (preserve caller's HL - symbol values etc)
F5; PUSH PSW
2A F5 06; LHLD OPTR
F1; POP PSW
77; MOV M,A
23; INX H
22 F5 06; SHLD OPTR
3A F4 06; LDA OCNT
3C; INR A
32 F4 06; STA OCNT
FE 80; CPI 128
CA FB 03; JZ OUT_FULL (buffer full, go write)
E1; POP H
C9; RET
; 03FB: OUT_FULL - Buffer full, write sector
CD 2F 04; CALL WRSEC (shifted +3)
21 80 07; LXI H,OBUF
22 F5 06; SHLD OPTR
AF; XRA A
32 F4 06; STA OCNT
E1; POP H
C9; RET

; 040A: OUT_P1 - Pass 1, just increment LOCTR
F1; POP PSW
E5; PUSH H
2A F8 06; LHLD LOCTR
23; INX H
22 F8 06; SHLD LOCTR
E1; POP H
C9; RET

; ============================================================
; 0415: FLUSH - Flush output buffer
; ============================================================
3A F4 06; LDA OCNT
B7; ORA A
C8; RZ
2A F5 06; LHLD OPTR
; 041D: FL1
3A F4 06; LDA OCNT
FE 80; CPI 128
D2 2F 04; JNC WRSEC (shifted +3)
36 00; MVI M,0
23; INX H
3C; INR A
32 F4 06; STA OCNT
C3 1D 04; JMP FL1 (shifted +3)

; 042F: WRSEC - Write sector
11 80 07; LXI D,OBUF
0E 1A; MVI C,26
CD 05 00; CALL BDOS
11 00 08; LXI D,OFCB
0E 15; MVI C,21 (write seq)
CD 05 00; CALL BDOS
C9; RET

; ============================================================
; 0440: NOFILE error
; ============================================================
11 47 04; LXI D,MNOF
C3 4F 04; JMP ERROR (shifted +3)

; 0446: DSKFUL error
11 4F 04; LXI D,MDSK
C3 4F 04; JMP ERROR (shifted +3)

; 044C: UNDEF error
11 59 04; LXI D,MUDF
; Fall through to ERROR

; 044F: ERROR
0E 09; MVI C,9
CD 05 00; CALL BDOS
C3 00 00; JMP BOOT

; ============================================================
; Messages
; ============================================================
; 0457: MNOF
4E 6F 20 66 69 6C 65 24; "No file$"
; 045F: MDSK
44 69 73 6B 20 66 75 6C 6C 24; "Disk full$"
; 0469: MUDF
55 6E 64 65 66 24; "Undef$"

; ============================================================
; 046F: DEFSYM - Define symbol
; HL = start of label in line buffer
; Value = current LOCTR
; ============================================================
; First, read label into temp and add to symbol table
; Symbol table at 0840, 8 bytes per entry (6 name + 2 value)
E5; PUSH H (label start)
3A F7 06; LDA SYMCNT
; Calculate slot: SYMTAB + SYMCNT * 8 (16-bit to handle >32 symbols)
6F; MOV L,A
26 00; MVI H,0
29; DAD H (x2)
29; DAD H (x4)
29; DAD H (x8)
11 40 08; LXI D,SYMTAB
19; DAD D
EB; XCHG (DE = slot address)
E1; POP H (label start)

; Copy up to 6 chars of label to slot
06 06; MVI B,6
; 0481: DS1
7E; MOV A,M
FE 3A; CPI ':'
CA 9A 04; JZ DS2 (end of label)
; Uppercase
FE 61; CPI 'a'
DA 93 04; JC DS1A
FE 7B; CPI 'z'+1
D2 93 04; JNC DS1A
D6 20; SUI 20H
; 0493: DS1A
12; STAX D
13; INX D
23; INX H
05; DCR B
C2 81 04; JNZ DS1 (shifted +3)

; 049A: DS2 - Pad with spaces if needed
7D; MOV A,L (just checking B)
; Actually check B
78; MOV A,B
B7; ORA A
CA A8 04; JZ DS3
3E 20; MVI A,' '
; 04A2: DS2A
12; STAX D
13; INX D
05; DCR B
C2 A2 04; JNZ DS2A

; 04A8: DS3 - Store value (LOCTR)
2A F8 06; LHLD LOCTR
7D; MOV A,L
12; STAX D
13; INX D
7C; MOV A,H
12; STAX D

; Increment symbol count
3A F7 06; LDA SYMCNT
3C; INR A
32 F7 06; STA SYMCNT
C9; RET

; ============================================================
; 04B8: LOOKUP - Look up symbol, advance LNPTR
; Returns: HL = value
; ============================================================
; Read symbol from line into temp, then search
2A FA 06; LHLD LNPTR
11 20 06; LXI D,TOKBUF (0620)
06 06; MVI B,6

; 04C0: LK0 - Copy symbol to TOKBUF
7E; MOV A,M
; Check for end of symbol (not alphanumeric)
FE 30; CPI '0'
DA 01 05; JC LK0E (end)
FE 3A; CPI '9'+1
DA E1 04; JC LK0C (is digit, continue)
; Uppercase
FE 61; CPI 'a'
DA D7 04; JC LK0B
FE 7B; CPI 'z'+1
D2 D7 04; JNC LK0B
D6 20; SUI 20H
; 04D7: LK0B - Check if letter
FE 41; CPI 'A'
DA 01 05; JC LK0E
FE 5B; CPI 'Z'+1
D2 01 05; JNC LK0E
; 04E1: LK0C - Copy char
12; STAX D
13; INX D
23; INX H
05; DCR B
C2 C0 04; JNZ LK0
; 04E8: LK0D - Skip remaining symbol chars
7E; MOV A,M
FE 61; CPI 'a'
DA F3 04; JC LK0D1
FE 7B; CPI 'z'+1
DA FD 04; JC LK0D2
; 04F3: LK0D1
FE 41; CPI 'A'
DA 11 05; JC LK1
FE 5B; CPI 'Z'+1
D2 11 05; JNC LK1
; 04FD: LK0D2 - Skip
23; INX H
C3 E8 04; JMP LK0D

; 0501: LK0E - End of symbol, pad with spaces
78; MOV A,B
B7; ORA A
CA 11 05; JZ LK1
3E 20; MVI A,' '
12; STAX D
13; INX D
05; DCR B
C2 01 05; JNZ LK0E+2
; Actually let me fix this
C3 01 05; JMP LK0E

; 0511: LK1 - Save updated line pointer
22 FA 06; SHLD LNPTR

; Search symbol table
21 40 08; LXI H,SYMTAB
3A F7 06; LDA SYMCNT
B7; ORA A
CA 3F 05; JZ LK_NF (not found)
47; MOV B,A

; 051F: LK2 - Compare entry with TOKBUF
E5; PUSH H
11 20 06; LXI D,TOKBUF (0620)
0E 06; MVI C,6
; 0525: LK3
1A; LDAX D
BE; CMP M
C2 36 05; JNZ LK4 (not match)
13; INX D
23; INX H
0D; DCR C
C2 25 05; JNZ LK3
; Match found!
; HL now points to value low byte
7E; MOV A,M
23; INX H
66; MOV H,M
6F; MOV L,A
D1; POP D (discard saved HL)
C9; RET

; 0536: LK4 - No match, try next
E1; POP H
; Advance to next entry (8 bytes)
11 08 00; LXI D,8
19; DAD D
05; DCR B
C2 1F 05; JNZ LK2

; 053F: LK_NF - Not found
; In pass 1, return 0
; In pass 2, error
3A F0 06; LDA PASS
B7; ORA A
CA 49 05; JZ LK_NF0
; Pass 2 - error
C3 4C 04; JMP UNDEF (shifted +3)

; 0549: LK_NF0 - Pass 1, return 0
21 00 00; LXI H,0
C9; RET

; ============================================================
; 054D: EXPR - Simple expression evaluator
; Just parse a number (hex with H suffix or $XX)
; Returns: HL = value
; ============================================================
CD EE 01; CALL SKIPWS
2A FA 06; LHLD LNPTR
7E; MOV A,M

; Check for $ prefix (hex)
FE 24; CPI '$'
CA C3 05; JZ EX_HEX (04F0)

; Check for digit
FE 30; CPI '0'
DA BF 05; JC EX_SYM (not digit, try symbol)
FE 3A; CPI '9'+1
D2 BF 05; JNC EX_SYM

; Parse number (could be hex with H or decimal)
; For simplicity, treat as hex if ends with H, else decimal
21 00 00; LXI H,0

; 0566: EX_NUM - Accumulate digits
2A FA 06; LHLD LNPTR
; 0569: Actually I need value in HL and ptr elsewhere
; Let me use DE for accumulator
E5; PUSH H
21 00 00; LXI H,0
EB; XCHG
E1; POP H

; 056F: EX_N1
7E; MOV A,M
; Uppercase
FE 61; CPI 'a'
DA 7C 05; JC EX_N1A
FE 7B; CPI 'z'+1
D2 7C 05; JNC EX_N1A
D6 20; SUI 20H
; 057C: EX_N1A
; Check for H suffix (end of hex)
FE 48; CPI 'H'
CA B9 05; JZ EX_NH (hex done)
; Check for digit 0-9
FE 30; CPI '0'
DA B7 05; JC EX_DONE
FE 3A; CPI '9'+1
DA 95 05; JC EX_DIG
; Check for A-F
FE 41; CPI 'A'
DA B7 05; JC EX_DONE
FE 47; CPI 'G'
D2 B7 05; JNC EX_DONE

; 0595: EX_DIG - Is hex digit
23; INX H
22 FA 06; SHLD LNPTR
; Shift DE left 4, add digit
; DE = DE * 16 + digit
E5; PUSH H
62; MOV H,D
6B; MOV L,E
29; DAD H
29; DAD H
29; DAD H
29; DAD H
EB; XCHG
E1; POP H
; Add digit value
7E; MOV A,M - wait, we advanced already
; Need to get char again from before advance
2B; DCX H
7E; MOV A,M
23; INX H
FE 41; CPI 'A'
DA B0 05; JC EX_D09
D6 37; SUI 37H
C3 B2 05; JMP EX_DAD
; 05B0: EX_D09
D6 30; SUI '0'
; 05B2: EX_DAD
83; ADD E
5F; MOV E,A
C3 6F 05; JMP EX_N1

; 05B7: EX_DONE - Return DE as result
EB; XCHG
C9; RET

; 05B9: EX_NH - 'H' found, skip it and return
23; INX H
22 FA 06; SHLD LNPTR
EB; XCHG
C9; RET

; 05BF: EX_SYM - Parse symbol
CD B8 04; CALL LOOKUP
C9; RET

; 05C3: EX_HEX - $XX hex format
23; INX H
22 FA 06; SHLD LNPTR
21 00 00; LXI H,0
EB; XCHG
2A FA 06; LHLD LNPTR

; 05CE: EXH1
7E; MOV A,M
FE 61; CPI 'a'
DA DB 05; JC EXH1A
FE 7B; CPI 'z'+1
D2 DB 05; JNC EXH1A
D6 20; SUI 20H
; 05DB: EXH1A
FE 30; CPI '0'
DA B7 05; JC EX_DONE
FE 3A; CPI '9'+1
DA EF 05; JC EXH_DG
FE 41; CPI 'A'
DA B7 05; JC EX_DONE
FE 47; CPI 'G'
D2 B7 05; JNC EX_DONE
; 05EF: EXH_DG
23; INX H
22 FA 06; SHLD LNPTR
E5; PUSH H
62; MOV H,D
6B; MOV L,E
29; DAD H
29; DAD H
29; DAD H
29; DAD H
EB; XCHG
E1; POP H
2B; DCX H
7E; MOV A,M
23; INX H
FE 41; CPI 'A'
DA 09 06; JC EXH_09
D6 37; SUI 37H
C3 0B 06; JMP EXH_AD
; 0609: EXH_09
D6 30; SUI '0'
; 060B: EXH_AD
83; ADD E
5F; MOV E,A
C3 CE 05; JMP EXH1

